{
  "manifest_version": 3,
  "name": "Lunar Start Page",
  "short_name": "Lunar Start",
  "description": "A furry new tab with cute pawprint wallpapers, animated backgrounds, Chinese community shortcuts, search, clocks and bookmarks.",
  "version": "1.2.1",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "resource/icons/lunar-v2-16.png",
    "32": "resource/icons/lunar-v2-32.png",
    "48": "resource/icons/lunar-v2-48.png",
    "128": "resource/icons/lunar-v2-128.png"
  },
  "action": {
    "default_title": "Lunar Start Page",
    "default_icon": {
      "16": "resource/icons/lunar-v2-16.png",
      "32": "resource/icons/lunar-v2-32.png",
      "48": "resource/icons/lunar-v2-48.png"
    }
  },
  "host_permissions": [
    "https://duckduckgo.com/*",
    "https://www.google.com/*",
    "https://api.bing.com/*",
    "https://search.yahoo.com/*",
    "https://suggestion.baidu.com/*",
    "https://www.sogou.com/*",
    "https://sug.so.360.cn/*"
  ],
  "permissions": [
    "storage",
    "alarms",
    "contextMenus"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ]
}
